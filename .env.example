NODE_ENV=development
PORT=5000

# Local Docker Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/casino?schema=public

# Neon (deploy) — replace when deploying
# DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/casino?sslmode=require
# DIRECT_URL=postgresql://user:pass@ep-xxxx.neon.tech/casino?sslmode=require

# Optional local Redis (docker compose --profile with-redis up -d)
REDIS_URL=redis://localhost:6379

# Provider IDs
# Staging: 18778596 | Production: 18778597
OPERATOR_ID=18778596
SHARED_KEY=change_me_shared_key

# Comma-separated RGS IPs (empty = skip whitelist in local)
RGS_IP_WHITELIST=

FRONTEND_URL=http://localhost:3003
