NODE_ENV=development
PORT=5000

# Local Docker Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/casino?schema=public

# Neon (deploy) — replace when deploying
# DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/casino?sslmode=require
# DIRECT_URL=postgresql://user:pass@ep-xxxx.neon.tech/casino?sslmode=require

# Optional local Redis (docker compose --profile with-redis up -d)
REDIS_URL=redis://localhost:6379

# Provider IDs
# Staging: 18778596 | Production: 18778597
OPERATOR_ID=18778596
SHARED_KEY=change_me_shared_key

# Comma-separated RGS IPs (empty = skip whitelist in local)
RGS_IP_WHITELIST=

FRONTEND_URL=http://localhost:3003

# Player site JWT (Auth Step 1)
JWT_SECRET=dev_jwt_secret_change_me
JWT_EXPIRES_HOURS=168

RGS_LAUNCH_BASE_URL=https://games.bcrgslaunchgame.com/authorization.php
CMS_GAMES_URL=https://www.cmsbetconstruct.com/casino/getGames
CMS_OPTIONS_URL=https://www.cmsbetconstruct.com/casino/getOptions
GAMES_CACHE_TTL_SEC=300

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_DISPLAY_NAME=Super Admin

# FX: how many MMK = 1 USD (wallet is USD; UI shows MMK)
MMK_PER_USD=4500

# What BetConstruct game client shows (Authenticate.Currency). Wallet DB stays USD.
# MMK | USD
RGS_DISPLAY_CURRENCY=MMK


