generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  nickname     String   @unique @db.VarChar(50)
  passwordHash String?  @map("password_hash")
  currency     String   @db.Char(3)
  country      String?  @db.Char(2)
  gender       Boolean?
  isBlocked    Boolean  @default(false) @map("is_blocked")
  /// Owning agent (master_agent or sub_agent AdminUser id)
  agentId      Int?     @map("agent_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  agent            AdminUser? @relation("AgentPlayers", fields: [agentId], references: [id])
  wallet           Wallet?
  sessions         Session[]
  authSessions     AuthSession[]
  transactions     Transaction[]
  ledger           WalletLedger[]
  paymentRequests  PaymentRequest[]
  agentPaymentRequests AgentPaymentRequest[]
  bonusClaims      BonusClaim[]
  questProgress    QuestProgress[]
  bigWins               BigWinEvent[]
  leaderboardStats      LeaderboardStat[]
  announcementDeliveries AnnouncementDelivery[]
  chatThreads            ChatThread[]

  @@index([isBlocked])
  @@index([createdAt])
  @@index([username])
  @@index([agentId])
  @@map("players")
}

/// Frontend site login sessions (≠ RGS game Session)
model AuthSession {
  id               Int       @id @default(autoincrement())
  playerId         Int       @map("player_id")
  jti              String    @unique @db.VarChar(64)
  isActive         Boolean   @default(true) @map("is_active")
  /// Access JWT / session outer bound (aligned with refresh expiry)
  expiresAt        DateTime  @map("expires_at")
  refreshTokenHash String?   @map("refresh_token_hash") @db.VarChar(128)
  refreshExpiresAt DateTime? @map("refresh_expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id])

  @@index([playerId, isActive])
  @@index([expiresAt])
  @@index([refreshTokenHash])
  @@map("auth_sessions")
}

model Wallet {
  id          Int     @id @default(autoincrement())
  playerId    Int     @unique @map("player_id")
  realBalance Decimal @default(0) @map("real_balance") @db.Decimal(18, 4)
  bonusMoney  Decimal @default(0) @map("bonus_money") @db.Decimal(18, 4)
  frozenMoney Decimal @default(0) @map("frozen_money") @db.Decimal(18, 4)
  bonusWin    Decimal @default(0) @map("bonus_win") @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt @map("updated_at")

  player Player @relation(fields: [playerId], references: [id])

  @@map("wallets")
}

/// RGS game launch tokens
model Session {
  id        Int       @id @default(autoincrement())
  playerId  Int       @map("player_id")
  token     String    @unique @db.VarChar(50)
  isActive  Boolean   @default(true) @map("is_active")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id])

  @@index([playerId, isActive])
  @@index([expiresAt])
  @@map("sessions")
}

/// RGS financial callbacks only
model Transaction {
  id                      Int      @id @default(autoincrement())
  playerId                Int      @map("player_id")
  rgsTransactionId        BigInt   @unique @map("rgs_transaction_id")
  rgsRelatedTransactionId BigInt?  @map("rgs_related_transaction_id")
  platformTransactionId   BigInt?  @map("platform_transaction_id")
  typeId                  Int      @map("type_id")
  direction               String   @db.VarChar(20)
  amount                  Decimal  @db.Decimal(18, 4)
  currency                String   @db.Char(3)
  gameId                  Int?     @map("game_id")
  bonusDefId              Int?     @map("bonus_def_id")
  status                  String   @default("completed") @db.VarChar(20)
  createdAt               DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id])

  @@index([playerId, createdAt(sort: Desc)])
  @@index([direction, createdAt(sort: Desc)])
  @@index([status])
  @@index([gameId])
  @@index([rgsRelatedTransactionId])
  @@map("transactions")
}

/// Non-RGS money moves (admin adjust, future payments)
model WalletLedger {
  id           Int      @id @default(autoincrement())
  playerId     Int      @map("player_id")
  adminId      Int?     @map("admin_id")
  type         String   @db.VarChar(30) // admin_credit | admin_debit | ...
  amount       Decimal  @db.Decimal(18, 4)
  balanceAfter Decimal  @map("balance_after") @db.Decimal(18, 4)
  currency     String   @db.Char(3)
  note         String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  player Player     @relation(fields: [playerId], references: [id])
  admin  AdminUser? @relation(fields: [adminId], references: [id])

  @@index([playerId, createdAt(sort: Desc)])
  @@index([adminId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("wallet_ledgers")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name") @db.VarChar(100)
  /// admin | master_agent | sub_agent
  role         String   @default("admin") @db.VarChar(20)
  isActive     Boolean  @default(true) @map("is_active")
  /// Master agent id when role = sub_agent
  parentId     Int?     @map("parent_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  parent          AdminUser?  @relation("AgentTree", fields: [parentId], references: [id])
  children        AdminUser[] @relation("AgentTree")
  players         Player[]    @relation("AgentPlayers")
  sessions        AdminAuthSession[]
  ledgers         WalletLedger[]
  paymentReviews  PaymentRequest[]
  agentPaymentsRequested AgentPaymentRequest[] @relation("AgentPaymentRequester")
  agentPaymentsAsMaster  AgentPaymentRequest[] @relation("AgentPaymentMaster")
  agentPaymentsReviewed  AgentPaymentRequest[] @relation("AgentPaymentReviewer")

  @@index([role, isActive])
  @@index([parentId])
  @@map("admin_users")
}

model AdminAuthSession {
  id               Int       @id @default(autoincrement())
  adminId          Int       @map("admin_id")
  jti              String    @unique @db.VarChar(64)
  isActive         Boolean   @default(true) @map("is_active")
  expiresAt        DateTime  @map("expires_at")
  refreshTokenHash String?   @map("refresh_token_hash") @db.VarChar(128)
  refreshExpiresAt DateTime? @map("refresh_expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([adminId, isActive])
  @@index([expiresAt])
  @@index([refreshTokenHash])
  @@map("admin_auth_sessions")
}

model PlatformSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// Admin-defined dynamic quest (bet goals → play-only bonus)
model Quest {
  id           Int      @id @default(autoincrement())
  title        String   @db.VarChar(120)
  description  String?  @db.VarChar(255)
  /// bet_count | bet_amount_usd
  goalType     String   @map("goal_type") @db.VarChar(30)
  targetValue  Decimal  @map("target_value") @db.Decimal(18, 4)
  rewardUsd    Decimal  @map("reward_usd") @db.Decimal(18, 4)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  progress QuestProgress[]

  @@index([isActive, createdAt(sort: Desc)])
  @@map("quests")
}

model QuestProgress {
  id             Int       @id @default(autoincrement())
  playerId       Int       @map("player_id")
  questId        Int       @map("quest_id")
  progressValue  Decimal   @default(0) @map("progress_value") @db.Decimal(18, 4)
  /// active | claimable | claimed
  status         String    @default("active") @db.VarChar(20)
  claimedAt      DateTime? @map("claimed_at")
  ledgerId       Int?      @map("ledger_id")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id])
  quest  Quest  @relation(fields: [questId], references: [id])

  @@unique([playerId, questId])
  @@index([playerId, status])
  @@index([questId])
  @@map("quest_progress")
}

/// Pre-aggregated leaderboard rollup (light filter queries)
model LeaderboardStat {
  id             Int      @id @default(autoincrement())
  playerId       Int      @map("player_id")
  agentId        Int?     @map("agent_id")
  /// day | week | all
  period         String   @db.VarChar(10)
  /// YYYY-MM-DD | YYYY-Www | all
  periodKey      String   @map("period_key") @db.VarChar(16)
  totalWinUsd    Decimal  @default(0) @map("total_win_usd") @db.Decimal(18, 4)
  totalBetUsd    Decimal  @default(0) @map("total_bet_usd") @db.Decimal(18, 4)
  netUsd         Decimal  @default(0) @map("net_usd") @db.Decimal(18, 4)
  biggestWinUsd  Decimal  @default(0) @map("biggest_win_usd") @db.Decimal(18, 4)
  username       String   @db.VarChar(50)
  nickname       String   @db.VarChar(50)
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, period, periodKey])
  @@index([period, periodKey, totalWinUsd(sort: Desc)])
  @@index([period, periodKey, totalBetUsd(sort: Desc)])
  @@index([period, periodKey, netUsd(sort: Desc)])
  @@index([period, periodKey, biggestWinUsd(sort: Desc)])
  @@index([period, periodKey, agentId, totalWinUsd(sort: Desc)])
  @@index([period, periodKey, agentId, totalBetUsd(sort: Desc)])
  @@index([period, periodKey, agentId, netUsd(sort: Desc)])
  @@index([period, periodKey, agentId, biggestWinUsd(sort: Desc)])
  @@map("leaderboard_stats")
}

/// Public big-win ticker events (win ≥ admin MMK threshold)
model BigWinEvent {
  id         Int      @id @default(autoincrement())
  playerId   Int      @map("player_id")
  agentId    Int?     @map("agent_id")
  gameId     Int?     @map("game_id")
  amountUsd  Decimal  @map("amount_usd") @db.Decimal(18, 4)
  amountMmk  Decimal  @map("amount_mmk") @db.Decimal(18, 2)
  rateUsed   Decimal  @map("rate_used") @db.Decimal(18, 4)
  username   String   @db.VarChar(50)
  nickname   String   @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([agentId, createdAt(sort: Desc)])
  @@map("big_win_events")
}

/// One claim per player per calendar day (Asia/Yangon) per kind
model BonusClaim {
  id        Int      @id @default(autoincrement())
  playerId  Int      @map("player_id")
  /// daily_login | quest_* (future)
  kind      String   @db.VarChar(40)
  /// YYYY-MM-DD in Asia/Yangon
  claimDate String   @map("claim_date") @db.Char(10)
  amountUsd Decimal  @map("amount_usd") @db.Decimal(18, 4)
  ledgerId  Int?     @map("ledger_id")
  createdAt DateTime @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, kind, claimDate])
  @@index([playerId, kind, createdAt(sort: Desc)])
  @@map("bonus_claims")
}

/// Manual deposit/withdraw — player requests MMK, wallet credits/debits USD
model PaymentRequest {
  id           Int       @id @default(autoincrement())
  playerId     Int       @map("player_id")
  type         String    @db.VarChar(20) // deposit | withdraw
  status       String    @default("pending") @db.VarChar(20) // pending | approved | rejected | cancelled
  amountMmk    Decimal   @map("amount_mmk") @db.Decimal(18, 2)
  amountUsd    Decimal   @map("amount_usd") @db.Decimal(18, 4)
  rateUsed     Decimal   @map("rate_used") @db.Decimal(18, 4) // MMK per 1 USD at request time
  method       String?   @db.VarChar(50) // kbz | wave | bank | cash | ...
  reference    String?   @db.VarChar(100) // slip / txn ref
  playerNote   String?   @map("player_note") @db.VarChar(255)
  adminId      Int?      @map("admin_id")
  adminNote    String?   @map("admin_note") @db.VarChar(255)
  reviewedAt   DateTime? @map("reviewed_at")
  ledgerId     Int?      @map("ledger_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  player Player     @relation(fields: [playerId], references: [id])
  admin  AdminUser? @relation(fields: [adminId], references: [id])

  @@index([playerId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([type, status])
  @@index([adminId, reviewedAt(sort: Desc)])
  @@map("payment_requests")
}

/// Sub-agent → Master deposit/withdraw requests for a downline player
model AgentPaymentRequest {
  id             Int       @id @default(autoincrement())
  requesterId    Int       @map("requester_id")
  masterId       Int       @map("master_id")
  playerId       Int       @map("player_id")
  /// deposit | withdraw
  type           String    @db.VarChar(20)
  /// pending | approved | rejected | cancelled
  status         String    @default("pending") @db.VarChar(20)
  amountMmk      Decimal   @map("amount_mmk") @db.Decimal(18, 2)
  amountUsd      Decimal   @map("amount_usd") @db.Decimal(18, 4)
  rateUsed       Decimal   @map("rate_used") @db.Decimal(18, 4)
  method         String?   @db.VarChar(50)
  reference      String?   @db.VarChar(100)
  requesterNote  String?   @map("requester_note") @db.VarChar(255)
  reviewerNote   String?   @map("reviewer_note") @db.VarChar(255)
  reviewedById   Int?      @map("reviewed_by_id")
  reviewedAt     DateTime? @map("reviewed_at")
  ledgerId       Int?      @map("ledger_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  requester AdminUser @relation("AgentPaymentRequester", fields: [requesterId], references: [id])
  master    AdminUser @relation("AgentPaymentMaster", fields: [masterId], references: [id])
  reviewer  AdminUser? @relation("AgentPaymentReviewer", fields: [reviewedById], references: [id])
  player    Player    @relation(fields: [playerId], references: [id])

  @@index([masterId, status, createdAt(sort: Desc)])
  @@index([requesterId, status, createdAt(sort: Desc)])
  @@index([playerId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("agent_payment_requests")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String   @db.VarChar(50)
  playerId  Int?     @map("player_id")
  adminId   Int?     @map("admin_id")
  request   Json?
  response  Json?
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([action, createdAt(sort: Desc)])
  @@index([playerId, createdAt(sort: Desc)])
  @@index([adminId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Platform broadcast to all players (fan-out via batch worker)
model Announcement {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(120)
  description      String    @db.VarChar(1000)
  /// queued | sending | done | failed
  status           String    @default("queued") @db.VarChar(20)
  createdByAdminId Int?      @map("created_by_admin_id")
  totalTargets     Int       @default(0) @map("total_targets")
  deliveredCount   Int       @default(0) @map("delivered_count")
  /// Cursor for batch fan-out (last player id processed)
  cursorPlayerId   Int       @default(0) @map("cursor_player_id")
  lastError        String?   @map("last_error") @db.VarChar(255)
  sentAt           DateTime? @map("sent_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  deliveries AnnouncementDelivery[]

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("announcements")
}

model AnnouncementDelivery {
  id             Int       @id @default(autoincrement())
  announcementId Int       @map("announcement_id")
  playerId       Int       @map("player_id")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  player       Player       @relation(fields: [playerId], references: [id])

  @@unique([announcementId, playerId])
  @@index([playerId, createdAt(sort: Desc)])
  @@index([playerId, readAt])
  @@index([announcementId, id])
  @@map("announcement_deliveries")
}

/// Admin-managed FAQ entries for the FAQ chat bot
model Faq {
  id        Int      @id @default(autoincrement())
  question  String   @db.VarChar(255)
  answer    String   @db.VarChar(2000)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages ChatMessage[]

  @@index([isActive, sortOrder, id])
  @@map("faqs")
}

/// Chat thread — FAQ now; later realtime/live agent reuses this
model ChatThread {
  id        Int      @id @default(autoincrement())
  playerId  Int      @map("player_id")
  /// faq | live
  mode      String   @default("faq") @db.VarChar(20)
  /// open | closed
  status    String   @default("open") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  player   Player        @relation(fields: [playerId], references: [id])
  messages ChatMessage[]

  @@index([playerId, status, updatedAt(sort: Desc)])
  @@index([mode, status])
  @@map("chat_threads")
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  threadId  Int      @map("thread_id")
  /// user | bot | agent (agent reserved for realtime later)
  role      String   @db.VarChar(20)
  /// faq | text
  kind      String   @default("faq") @db.VarChar(20)
  faqId     Int?     @map("faq_id")
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at")

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  faq    Faq?       @relation(fields: [faqId], references: [id])

  @@index([threadId, createdAt])
  @@index([faqId])
  @@map("chat_messages")
}
